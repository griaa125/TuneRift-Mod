{
  "name": "ym-electron",
  "version": "1.0.0",
  "description": "Electron-обёртка над music.yandex.ru с поддержкой Chrome-расширений, PulseSync-аддонов и Discord Rich Presence",
  "main": "src/main.js",
  "scripts": {
    "prestart": "node scripts/set-macos-dev-icon.js",
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "discord-rpc": "^4.0.1"
  },
  "build": {
    "appId": "com.grigory.ymelectron",
    "productName": "Яндекс Музыка",
    "files": ["src/**/*", "addons/**/*", "extensions/**/*"],
    "asarUnpack": ["extensions/**/*"],
    "mac": { "target": "dmg", "icon": "build/icon.icns" },
    "win": { "target": "nsis", "icon": "build/ym_logo.png" },
    "linux": { "target": "AppImage", "icon": "build/ym_logo.png" }
  }
}
