{
  "manifest_version": 3,
  "name": "Старый дизайн Яндекс Музыки (TuneRift)",
  "version": "1.5.0",
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.by/*",
        "https://music.yandex.kz/*",
        "https://music.yandex.uz/*",
        "https://music.yandex.com/*",
        "https://music.yandex.net/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
